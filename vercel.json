{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/visit.js": { "maxDuration": 10 }
  },
  "redirects": [
    { "source": "/portfolio", "destination": "/work", "permanent": true },
    { "source": "/services", "destination": "/experience", "permanent": true },
    { "source": "/blog", "destination": "/notes", "permanent": true },
    { "source": "/opsrelay", "destination": "/work/opsrelay", "permanent": true },
    { "source": "/test", "destination": "/", "permanent": false },
    { "source": "/resume", "destination": "/resume.pdf", "permanent": false },
    { "source": "/images/TMW.pdf", "destination": "/resume.pdf", "permanent": false },
    { "source": "/images/TahaMohyuddin_Res.pdf", "destination": "/resume.pdf", "permanent": false },
    { "source": "/images/TahaMohyuddin_Res-2.pdf", "destination": "/resume.pdf", "permanent": false },
    { "source": "/images/ResTMpdf.pdf", "destination": "/resume.pdf", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://formsubmit.co; form-action 'self' https://formsubmit.co; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; manifest-src 'self'; upgrade-insecure-requests" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(fonts|images)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ]
}
