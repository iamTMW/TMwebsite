# Copy to .env.local for local experiments (never commit real values).
# In production, set these in Vercel > Project > Settings > Environment Variables (server-side only).
# None of these use a NEXT_PUBLIC_/VITE_ prefix, and none are read by browser code.

# Master switch for visit emails. Anything other than "true" disables them.
VISIT_NOTIFY_ENABLED=false

# "send" uses Resend. "mock" logs the subject line instead of sending (safe for testing).
VISIT_EMAIL_MODE=mock

# Fixed recipient. Visitors can never choose it.
VISIT_NOTIFY_TO=you@example.com
# Must use a domain you have verified in Resend, e.g. "Portfolio <alerts@notify.example.com>".
VISIT_NOTIFY_FROM=Portfolio <alerts@notify.example.com>

# Resend API key, scoped to "Sending access" for the one verified domain.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Upstash Redis REST credentials (the Vercel Marketplace integration may name them KV_REST_API_URL/TOKEN; both work).
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me

# Secret for hashing visitor IPs before they touch Redis. At least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VISIT_HASH_SECRET=replace-with-64-hex-characters

# Optional limits (defaults shown). Worst case per day is MAX_PER_DAY + 1 "paused" notice.
VISIT_MAX_EMAILS_PER_HOUR=6
VISIT_MAX_EMAILS_PER_DAY=30
VISIT_ALLOWED_HOSTS=www.tahamohyuddin.com,tahamohyuddin.com
VISIT_TIME_ZONE=America/Toronto
